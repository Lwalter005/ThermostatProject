<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefWidth="708.0" spacing="20.0" styleClass="outerBox" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.fooddoodsinc.thermostatproject.ThermostatController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <AnchorPane prefHeight="200.0" prefWidth="200.0" styleClass="displayBoxDropShadow">
               <children>
                  <AnchorPane maxHeight="400.0" maxWidth="600.0" minHeight="400.0" minWidth="600.0" prefHeight="400.0" prefWidth="600.0" styleClass="displayBox">
                     <children>
                        <Label fx:id="targetTempDisplay" layoutX="360.0" layoutY="88.0" styleClass="tempDisplayLabel" text="  " />
                        <Label fx:id="currentTempDisplay" layoutX="39.0" layoutY="88.0" styleClass="tempDisplayLabel" text="  " />
                        <Label fx:id="fanDisplay" layoutX="104.0" layoutY="334.0" styleClass="modeDisplayLabel" text="    " />
                        <Label fx:id="systemModeDisplay" layoutX="360.0" layoutY="334.0" styleClass="modeDisplayLabel" text="    " />
                        <Label fx:id="targetTempLabel" layoutX="444.0" layoutY="50.0" styleClass="modeDisplayLabel" text="   " />
                        <Label fx:id="currentTempLabel" layoutX="49.0" layoutY="50.0" styleClass="modeDisplayLabel" text="    " />
                     </children>
                  </AnchorPane>
               </children>
            </AnchorPane>
            <AnchorPane prefHeight="200.0" prefWidth="200.0" styleClass="dropShadowPane">
               <children>
                  <Button layoutX="18.0" layoutY="98.0" maxHeight="50.0" maxWidth="50.0" minHeight="50.0" minWidth="50.0" mnemonicParsing="false" onAction="#onTempUpButtonClick" prefHeight="50.0" prefWidth="50.0" styleClass="tempButton" text="^" />
                  <Button layoutX="18.0" layoutY="245.0" maxHeight="50.0" maxWidth="50.0" minHeight="50.0" minWidth="50.0" mnemonicParsing="false" onAction="#onTempDownButtonClick" prefHeight="50.0" prefWidth="50.0" styleClass="tempButton" text="v" />
               </children>
            </AnchorPane>
         </children>
      </HBox>
      <AnchorPane maxHeight="80.0" minHeight="80.0" prefHeight="80.0" styleClass="dropShadowPane">
         <children>
            <Button layoutX="121.0" layoutY="13.0" maxHeight="50.0" maxWidth="100.0" minHeight="50.0" minWidth="100.0" mnemonicParsing="false" onAction="#onFanButtonClick" prefHeight="50.0" prefWidth="100.0" styleClass="modeButton" text="Fan" />
            <Button layoutX="375.0" layoutY="13.0" maxHeight="50.0" maxWidth="100.0" minHeight="50.0" minWidth="100.0" mnemonicParsing="false" onAction="#onModeButtonClick" prefHeight="50.0" prefWidth="100.0" styleClass="modeButton" text="Mode" />
            <Button layoutX="618.0" layoutY="13.0" maxHeight="50.0" maxWidth="50.0" minHeight="50.0" minWidth="50.0" mnemonicParsing="false" onAction="#onPowerButtonClick" prefHeight="50.0" prefWidth="50.0" styleClass="powerButton" text="Power" />
         </children>
      </AnchorPane>
   </children>
</VBox>
